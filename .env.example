# ------------------------------------------------------------------
# CryptoScanner — variáveis de ambiente
# Copie para .env.local (Next.js) e/ou .env (Prisma, worker, Docker).
# Nenhuma destas variáveis é exposta ao navegador, exceto as NEXT_PUBLIC_*.
# ------------------------------------------------------------------

# --- Aplicação ---
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=CryptoScanner
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Segredo para assinar o JWT de sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 48
AUTH_SECRET=troque-este-valor-por-um-segredo-com-pelo-menos-32-caracteres
# Duração da sessão em dias
AUTH_SESSION_DAYS=7

# --- Banco de dados (PostgreSQL) ---
# Opcional para navegar; obrigatório para login, watchlist, agentes, alertas e análises salvas.
DATABASE_URL=postgresql://cryptoscanner:cryptoscanner@localhost:5432/cryptoscanner?schema=public
# Conexão direta (sem pooler) usada apenas pelas migrations. Em Neon: URL sem "-pooler". Local: igual à DATABASE_URL.
DIRECT_URL=postgresql://cryptoscanner:cryptoscanner@localhost:5432/cryptoscanner?schema=public

# --- Cache (Redis) ---
# Opcional. Sem REDIS_URL o cache roda em memória (por processo).
REDIS_URL=redis://localhost:6379

# --- Provedores de dados de mercado (públicos, sem chave) ---
# Ordem de fallback para candles/tickers. Binance responde 451 fora de regiões permitidas; Kraken cobre esse caso.
MARKET_PROVIDERS=binance,kraken
BINANCE_REST_URL=https://api.binance.com
# Base oficial "market data only" da Binance (sem chave, sem bloqueio regional); usada quando a principal responde 451
BINANCE_REST_FALLBACK_URLS=https://data-api.binance.vision
BINANCE_WS_URL=wss://stream.binance.com:9443/stream
BINANCE_WS_FALLBACK_URL=wss://data-stream.binance.vision:9443/stream
# Futures USDⓈ-M (público): funding rate, open interest, long/short e agressão taker no Panorama
BINANCE_FUTURES_REST_URL=https://fapi.binance.com
KRAKEN_REST_URL=https://api.kraken.com
COINGECKO_REST_URL=https://api.coingecko.com/api/v3
# Chave demo/pro do CoinGecko (opcional; sem chave o limite público é baixo)
COINGECKO_API_KEY=
# Timeout por chamada HTTP (ms)
HTTP_TIMEOUT_MS=8000

# --- Sentimento (fontes públicas) ---
FNG_URL=https://api.alternative.me/fng/
NEWS_RSS_URLS=https://cointelegraph.com/rss,https://www.coindesk.com/arc/outboundfeeds/rss

# --- IA / LLM (opcional) ---
# none  -> agentes 100% determinísticos; análise de imagem desativada com mensagem clara
# anthropic -> interpretação textual e análise de imagem via API da Anthropic
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_MS=30000

# --- Telegram (opcional; alertas dos agentes) ---
TELEGRAM_BOT_TOKEN=

# --- Cron HTTP (hospedagem serverless, ex.: Vercel) ---
# Segredo para GET/POST /api/cron/cycle (a cada 5 min) e /api/cron/whales (a cada 10 min) via QStash/cron-job.org. Gere com: openssl rand -hex 24
CRON_SECRET=

# --- Worker ---
# Intervalo do ciclo de scanner/agentes/alertas em segundos (referência pública: 5 min)
WORKER_CYCLE_SECONDS=300
# Cooldown mínimo entre alertas do mesmo agente (min)
AGENT_ALERT_COOLDOWN_MINUTES=30
# Habilita WebSocket da Binance no worker (desligue em regiões bloqueadas)
WORKER_ENABLE_BINANCE_WS=true

# --- Rate limiting (por IP, janela de 60 s) ---
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_LLM_PER_MINUTE=5

# --- Planos (sem cobrança integrada) ---
# true -> usuário pode trocar o próprio plano em /planos (ambiente de desenvolvimento/teste)
ALLOW_SELF_PLAN_CHANGE=true

# --- Logs ---
LOG_LEVEL=info

# --- Uso pessoal: OWNER_EMAILS cadastra sem código e recebe ADMIN + PLATINUM; com OWNER_EMAILS definido,
#     mais ninguém se cadastra, a não ser com REGISTRATION_INVITE_CODE (usado também pelos testes em produção)
OWNER_EMAILS=
REGISTRATION_INVITE_CODE=
# --- Cron: segredo só no cabeçalho Authorization depois de migrar os agendamentos
CRON_ALLOW_QUERY_SECRET=true
# --- Web Push: opcional. Sem estas variáveis o app gera as chaves uma vez e guarda no banco (AppSetting "vapid")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# ------------------------------------------------------------------ Venda (SaaS)
# Mercado Pago (assinaturas). Sem token o checkout fica desligado.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PRICE_PRO_BRL=97
PRICE_ELITE_BRL=197
# invite (padrão: código de convite/e-mail do dono) | open (venda aberta)
REGISTRATION_MODE=invite
# Fornecedor/controlador (Termos, Privacidade, Reembolso). Checkout só liga com todos preenchidos
# e LEGAL_TERMS_APPROVED=true (depois da revisão humana dos documentos).
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_DOC=
LEGAL_ENTITY_ADDRESS=
SUPPORT_EMAIL=
DPO_EMAIL=
LEGAL_TERMS_VERSION=2026-09-29
LEGAL_TERMS_APPROVED=false
# E-mail transacional (Resend): boas-vindas, avisos do teste, cobrança e redefinição de senha.
RESEND_API_KEY=
EMAIL_FROM=
