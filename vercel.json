{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["gru1"],
  "buildCommand": "prisma generate && prisma migrate deploy && next build",
  "crons": [
    { "path": "/api/cron/cycle", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/monitors", "schedule": "2-59/5 * * * *" },
    { "path": "/api/cron/whales", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/backtest", "schedule": "30 3 * * *" }
  ]
}
