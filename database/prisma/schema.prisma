// Esquema de dados do CryptoScanner.
// Gerado/aplicado com: npm run db:migrate (produção) ou npm run db:migrate:dev (desenvolvimento).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexão direta para migrations (Neon: host sem "-pooler"); localmente pode ser igual à DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------
// Usuários, planos e preferências
// ------------------------------------------------------------------

enum Plan {
  FREE
  PRO
  PLATINUM
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  plan         Plan     @default(FREE)
  role         Role     @default(USER)
  telegramChatId String?
  /// versão dos termos aceita no cadastro (ou depois) e quando
  termsVersion    String?
  termsAcceptedAt DateTime?
  onboardedAt     DateTime?
  /// sessões (JWT) emitidas antes desta data são recusadas (troca/redefinição de senha)
  passwordChangedAt DateTime?
  /// id da conta Google (sub) quando a conta foi criada ou vinculada pelo login com Google
  googleSub    String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  preference     UserPreference?
  watchlists     Watchlist[]
  agents         Agent[]
  alerts         Alert[]
  chartAnalyses  ChartAnalysis[]
  scanHistory    ScanHistoryEntry[]
  supportTickets SupportTicket[]
  simulations    Simulation[]
  agentExecutions AgentExecution[]
  pushSubscriptions PushSubscription[]
  subscription      Subscription?
  strategies        Strategy[]
  monitors          Monitor[]
  monitorEvents     MonitorEvent[]
  passwordResets    PasswordReset[]
}

model UserPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  theme            String   @default("dark") // dark | light | system
  currency         String   @default("USD")  // USD | BRL
  defaultTimeframe String   @default("4h")
  autoRefreshSec   Int      @default(30)
  language         String   @default("pt-BR")
  /** progresso da Jornada Trader: { "slug": { done: bool, score: n, at: iso } } */
  learning         Json?
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------
// Ativos e dados de mercado
// ------------------------------------------------------------------

model Asset {
  id           String   @id @default(cuid())
  symbol       String   @unique // BTC
  name         String            // Bitcoin
  binancePair  String   @unique  // BTCUSDT
  krakenPair   String?           // XBTUSD
  coingeckoId  String?           // bitcoin
  quote        String   @default("USDT")
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  candles        Candle[]
  indicators     Indicator[]
  snapshots      MarketSnapshot[]
  scannerResults ScannerResult[]
  watchlistItems WatchlistItem[]
  alerts         Alert[]
}

// Snapshot de ticker (preço/variação/volume) coletado pelo worker.
model MarketSnapshot {
  id             String   @id @default(cuid())
  assetId        String
  price          Float
  changePct24h   Float
  high24h        Float
  low24h         Float
  volume24h      Float    // volume em moeda base
  quoteVolume24h Float    // volume em moeda de cotação (USDT/USD)
  source         String   // binance | kraken | coingecko
  collectedAt    DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, collectedAt(sort: Desc)])
}

model Candle {
  id        String   @id @default(cuid())
  assetId   String
  timeframe String   // 5m 15m 30m 1h 4h 1d 1w
  openTime  DateTime
  closeTime DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  source    String

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, timeframe, openTime])
  @@index([assetId, timeframe, openTime(sort: Desc)])
}

// Último valor calculado de cada indicador por ativo/timeframe (materializado pelo worker).
model Indicator {
  id         String   @id @default(cuid())
  assetId    String
  timeframe  String
  name       String   // ema8, rsi14, macd, bb20, atr14, stochrsi...
  value      Json
  computedAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, timeframe, name])
}

// ------------------------------------------------------------------
// Scanner
// ------------------------------------------------------------------

model ScannerResult {
  id          String   @id @default(cuid())
  runId       String   // agrupa os resultados de um ciclo
  assetId     String
  timeframe   String
  pattern     String   // chave do padrão (double_bottom, head_shoulders...)
  direction   String   // bullish | bearish | neutral
  confidence  Float    // 0..100
  price       Float
  target      Float?
  stop        Float?
  details     Json
  detectedAt  DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([assetId, timeframe, detectedAt(sort: Desc)])
}

// Histórico de alertas do scanner por usuário (aba "Histórico de Alertas").
model ScanHistoryEntry {
  id         String   @id @default(cuid())
  userId     String
  symbol     String
  timeframe  String
  kind       String   // pattern | volume
  title      String
  direction  String
  confidence Float?
  payload    Json
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// ------------------------------------------------------------------
// Watchlist / Carteira
// ------------------------------------------------------------------

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("Favoritos")
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id          String   @id @default(cuid())
  watchlistId String
  assetId     String
  note        String?
  // posição simulada (opcional) para a página Carteira
  quantity    Float?
  avgPrice    Float?
  addedAt     DateTime @default(now())

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, assetId])
}

// ------------------------------------------------------------------
// Agentes (configuração do usuário) e execuções
// ------------------------------------------------------------------

enum AgentStatus {
  ACTIVE
  PAUSED
  STOPPED
}

model Agent {
  id             String      @id @default(cuid())
  userId         String
  name           String
  icon           String      @default("🤖")
  description    String?
  symbols        String[]    // ["BTC","ETH"]
  operationType  String      // day_trade | swing_trade
  timeframe      String      // 1h 4h 1d 1w
  strategies     String[]    // chaves de agents/strategies
  minConfidence  Int         @default(70)
  notification   String      @default("log") // log | telegram | both
  kind           String      @default("agent") // agent | sentinel (vigia multipadrão por moeda)
  status         AgentStatus @default(ACTIVE)
  lastRunAt      DateTime?
  lastAlertAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions AgentExecution[]
  logs       AgentLog[]

  @@index([userId, status])
  @@index([userId, kind])
}

// Uma execução do pipeline multiagente (por ativo/timeframe), disparada pelo worker, pela API ou por um Agent.
model AgentExecution {
  id          String   @id @default(cuid())
  agentId     String?  // Agent do usuário (opcional: execuções ad hoc não têm)
  userId      String?
  symbol      String
  timeframe   String
  trigger     String   // api | worker | agent
  status      String   // running | succeeded | failed | partial
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  durationMs  Int?
  error       String?

  agent   Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  results AgentResult[]

  @@index([symbol, timeframe, startedAt(sort: Desc)])
  @@index([agentId, startedAt(sort: Desc)])
}

// Saída de cada agente dentro de uma execução.
model AgentResult {
  id          String   @id @default(cuid())
  executionId String
  agentName   String   // market-agent, scanner-agent, ...
  status      String   // ok | fallback | error | skipped
  output      Json
  logs        Json
  durationMs  Int
  createdAt   DateTime @default(now())

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model AgentLog {
  id        String   @id @default(cuid())
  agentId   String
  level     String   // info | signal | warn | error
  symbol    String?
  message   String
  data      Json?
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt(sort: Desc)])
}

// ------------------------------------------------------------------
// Alertas de preço/indicador do usuário
// ------------------------------------------------------------------

model Alert {
  id          String    @id @default(cuid())
  userId      String
  assetId     String
  kind        String    // price_above | price_below | rsi_above | rsi_below | pattern | volume
  timeframe   String    @default("4h")
  threshold   Float?
  pattern     String?
  channel     String    @default("log") // log | telegram | both
  active      Boolean   @default(true)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

// ------------------------------------------------------------------
// Análise de gráfico por IA (imagem)
// ------------------------------------------------------------------

model ChartAnalysis {
  id          String   @id @default(cuid())
  userId      String
  symbol      String?
  timeframe   String?
  imageSha256 String
  imageMime   String
  provider    String
  model       String
  result      Json
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// ------------------------------------------------------------------
// Suporte
// ------------------------------------------------------------------

// Simulação histórica salva pelo usuário (parâmetros + resultado resumido).
model Simulation {
  id                  String   @id @default(cuid())
  userId              String
  symbol              String
  strategy            String   // dca | lump_sum
  currency            String   // USD | BRL
  initialCapital      Float
  monthlyContribution Float
  months              Int
  riskProfile         String   // conservador | moderado | arrojado
  totalInvested       Float
  finalValue          Float
  profitPct           Float
  maxDrawdownPct      Float
  result              Json     // SimulationResult sem a curva completa
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  subject   String
  message   String
  status    String   @default("open")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ------------------------------------------------------------------
// Estatística real dos padrões, push no navegador e monitoramento
// ------------------------------------------------------------------

/// Resultado agregado do backtest walk-forward por padrão e timeframe (recalculado diariamente).
model PatternStat {
  id           String   @id @default(cuid())
  timeframe    String
  patternKey   String
  samples      Int
  wins         Int
  losses       Int
  expired      Int
  hitRate      Float?
  avgReturnPct Float?
  avgBars      Float?
  assets       Int
  fromTime     DateTime
  toTime       DateTime
  computedAt   DateTime @default(now())

  @@unique([timeframe, patternKey])
}

/// Sinal de padrão registrado ao vivo pelo ciclo e acompanhado até alvo, stop ou expiração.
model PatternSignal {
  id          String    @id @default(cuid())
  symbol      String
  timeframe   String
  patternKey  String
  direction   String
  confidence  Float
  entry       Float
  target      Float
  stop        Float
  detectedAt  DateTime  @default(now())
  candleTime  DateTime
  status      String    @default("open") // open | win | loss | expired
  resolvedAt  DateTime?
  exitPrice   Float?
  returnPct   Float?

  @@index([status])
  @@index([patternKey, timeframe, status])
  @@index([symbol, timeframe, patternKey, detectedAt(sort: Desc)])
}

/// Inscrição Web Push (VAPID) de um navegador.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  lastError String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Execução de tarefas agendadas (heartbeat para /status e alerta de falhas consecutivas).
model CronRun {
  id         String   @id @default(cuid())
  job        String
  ok         Boolean
  durationMs Int
  detail     Json?
  startedAt  DateTime @default(now())

  @@index([job, startedAt(sort: Desc)])
}

/// Configuração gerada pelo próprio app (ex.: chaves VAPID quando não definidas no ambiente).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Backtest walk-forward agregado por padrão × timeframe × ativo × regime ("*" = todos). Recalculado diariamente.
model BacktestStat {
  id           String   @id @default(cuid())
  timeframe    String
  patternKey   String
  symbol       String   @default("*")
  regime       String   @default("*")
  samples      Int
  hitRate      Float?
  expectancyR  Float?
  profitFactor Float?
  /** PatternStat completo (R, MAE/MFE, drawdown, 1R/2R/3R) */
  metrics      Json
  fromTime     DateTime
  toTime       DateTime
  computedAt   DateTime @default(now())

  @@unique([timeframe, patternKey, symbol, regime])
  @@index([timeframe, symbol, regime])
}

// ------------------------------------------------------------------
// Assinaturas (trial 7 dias → PRO | ELITE) — fonte de verdade do acesso
// ------------------------------------------------------------------

/// Estado da assinatura do usuário. User.plan é derivado daqui (FREE = sem acesso pago).
model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  /// PRO | ELITE (durante o trial: PRO)
  plan                   String    @default("PRO")
  /// TRIALING | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  status                 String    @default("TRIALING")
  trialStartedAt         DateTime?
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  provider               String?
  providerSubscriptionId String?   @unique
  lastPaymentStatus      String?
  /// último aviso de ciclo de vida enviado (trial_ending | trial_last_day | trial_ended) — evita repetição
  lastNoticeKind         String?
  lastNoticeAt           DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, trialEndsAt])
}

/// Eventos de cobrança recebidos (idempotência de webhook e auditoria).
model BillingEvent {
  id         String   @id @default(cuid())
  provider   String
  /// chave de idempotência: provider + x-request-id (ou id do evento)
  eventKey   String   @unique
  type       String
  resourceId String?
  payload    Json
  processed  Boolean  @default(false)
  error      String?
  createdAt  DateTime @default(now())

  @@index([resourceId])
}

// ------------------------------------------------------------------
// R2 — estratégias, monitores, eventos, analytics, recuperação de senha
// ------------------------------------------------------------------

/// Estratégia do usuário: regras AND/OR com timeframe por condição (MTF nativo). Reutilizada no scanner,
/// no monitor e no backtest ("escreva uma vez, use em todo lugar").
model Strategy {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  /// { direction, logic: "AND"|"OR", groups: [{ logic, conditions: [{ tf, feature, op, value }] }], exits }
  definition  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitors Monitor[]

  @@index([userId])
}

/// Monitor contínuo avaliado no servidor (ciclo do cron): estado do setup ou estratégia salva.
model Monitor {
  id          String    @id @default(cuid())
  userId      String
  symbol      String
  timeframe   String
  exchange    String    @default("binance")
  instrument  String    @default("spot")
  /// SETUP (estados do setup) | STRATEGY (condições de uma estratégia salva)
  kind        String    @default("SETUP")
  strategyId  String?
  /// estados que notificam: READY, TRIGGERED, ACTIVE, TARGET_HIT, INVALIDATED, EXPIRED
  states      String[]  @default(["READY", "TRIGGERED", "INVALIDATED", "TARGET_HIT"])
  minScore    Int       @default(60)
  /// canais: inapp sempre; push e telegram opcionais
  notifyPush     Boolean @default(true)
  notifyTelegram Boolean @default(false)
  active      Boolean   @default(true)
  lastState   String?
  lastScore   Int?
  lastCheckedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy Strategy?      @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  events   MonitorEvent[]

  @@unique([userId, symbol, timeframe, exchange, instrument, kind, strategyId])
  @@index([active, lastCheckedAt])
}

/// Evento do alert engine. `fingerprint` único = deduplicação (o mesmo fato nunca notifica duas vezes).
model MonitorEvent {
  id          String    @id @default(cuid())
  monitorId   String?
  userId      String
  fingerprint String    @unique
  kind        String
  title       String
  body        String
  payload     Json
  channels    String[]  @default([])
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  monitor Monitor? @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Eventos de produto (funil e uso). Sem dado pessoal além do userId; IP não é gravado.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  anonId    String?
  name      String
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId, createdAt])
}

/// Recuperação de senha: guarda só o hash SHA-256 do token (o token vai por e-mail).
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Registros de acesso (Marco Civil da Internet, art. 15: provedor de aplicação PJ guarda por 6 meses).
/// Só IP, evento e data/hora; sem conteúdo. Limpeza automática após 190 dias.
model AccessLog {
  id        String   @id @default(cuid())
  userId    String?
  ip        String
  event     String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Compra feita fora do app (Kiwify): guardada pelo e-mail do comprador e aplicada à conta com o mesmo e-mail
/// (na hora, se a conta existe; no cadastro/login, se ainda não existe).
model ExternalGrant {
  id               String    @id @default(cuid())
  provider         String
  /// id da assinatura (ou do pedido, sem assinatura) no provedor — uma linha por assinatura
  externalId       String
  email            String
  /// PRO | ELITE
  plan             String
  /// ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  status           String
  currentPeriodEnd DateTime?
  lastEvent        String
  lastOrderId      String?
  appliedUserId    String?
  appliedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([provider, externalId])
  @@index([email])
}
