    "tooltip": {
      "purpose": [
        "explicar indicadores",
        "explicar padrões",
        "explicar scores",
        "explicar timeframes"
      ],
      "rule": "Permitir compreensão sem obrigar o usuário a sair da tela."
    },
    "toast": {
      "position": "top-right",
      "types": [
        "success",
        "warning",
        "error",
        "info"
      ],
      "duration": "4–6 segundos"
    },
    "command_palette": {
      "shortcut": "Ctrl+K",
      "search_examples": [
        "BTC",
        "Scanner",
        "Alertas",
        "Configurações"
      ],
      "purpose": "Aumentar velocidade e percepção premium."
    },
    "global_search": {
      "accepted_examples": [
        "BTC",
        "Bitcoin",
        "BTCUSDT"
      ],
      "behavior": "Resultado imediato."
    }
  },
  "navigation": {
