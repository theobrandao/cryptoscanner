    "borders": {
      "default": "rgba(148, 163, 184, 0.12)",
      "hover": "rgba(56, 189, 248, 0.28)",
      "active": "rgba(34, 211, 238, 0.50)"
    },
    "brand": {
      "cyan": "#22D3EE",
      "blue": "#1687FF",
      "blue_primary": "#2563EB",
      "violet": "#7C3AED",
      "violet_light": "#8B5CF6"
    },
    "text": {
      "primary": "#F8FAFC",
      "secondary": "#94A3B8",
      "muted": "#64748B",
      "disabled": "#475569"
    },
    "financial": {
      "positive": "#10B981",
      "positive_soft": "rgba(16,185,129,.12)",
      "negative": "#EF4444",
      "negative_soft": "rgba(239,68,68,.12)",
      "warning": "#F59E0B",
      "info": "#38BDF8",
      "rule": "Verde e vermelho devem carregar significado financeiro, nunca serem usados apenas como decoração."
