    "official_brand_gradient": "linear-gradient(135deg, #22D3EE 0%, #1687FF 38%, #3655FF 65%, #8B2CFF 100%)"
  },
  "typography": {
    "primary_font": "Inter",
    "fallbacks": [
      "system-ui",
      "sans-serif"
    ],
    "alternative": "Geist",
    "weights": [
      400,
      500,
      600,
      700
    ],
    "avoid_weights": [
      800,
      900
    ],
    "hierarchy": {
      "h1": {
        "font_size": "32px",
        "font_weight": 700,
        "letter_spacing": "-0.035em"
      },
      "h2": {
        "font_size": "24px",
        "font_weight": 650,
        "letter_spacing": "-0.025em"
      },
      "h3": {
        "font_size": "18px",
        "font_weight": 600
      },
      "body": {
        "font_size": "14px",
        "line_height": 1.5
      },
      "small_data": {
        "font_size": "12px",
        "font_weight": 500
      }
    },
    "financial_numbers": {
      "font_variant_numeric": "tabular-nums",
      "font_feature_settings": "\"tnum\"",
      "reason": "Evitar números pulando horizontalmente quando valores mudam."
    }
  },
  "layout": {
    "desktop_grid": "12 colunas",
    "container_max_width": "1440px",
    "page_padding": {
      "desktop": "32px",
      "tablet": "24px",
      "mobile": "16px"
    },
    "spacing_scale_px": [
      4,
      8,
      12,
      16,
      20,
      24,
      32,
      40,
      48,
      64
    ],
    "rule": "Não utilizar espaçamentos arbitrários fora da escala."
  },
  "radii": {
    "cards": "12px",
    "modals": "16px",
    "inputs": "8px",
    "badges": "999px",
    "rule": "Evitar interfaces excessivamente arredondadas."
  },
  "elevation_and_effects": {
    "card_shadow": "0 8px 30px rgba(0,0,0,.22)",
    "brand_glow": "0 0 30px rgba(34,211,238,.14)",
    "background_ambient_glow": "radial-gradient(circle at 20% 0%, rgba(37,99,235,.08), transparent 35%)",
    "glassmorphism": {
      "allowed_for": [
        "modal",
        "command palette",
        "tooltip",
        "dropdown",
        "overlays",
        "cards especiais"
      ],
      "background": "rgba(15,23,42,.70)",
      "backdrop_filter": "blur(16px)",
      "border": "1px solid rgba(255,255,255,.08)",
      "rule": "Não transformar todo o dashboard em vidro."
    },
    "gradient_rule": "Gradientes apenas em logo, CTA premium, badges, IA e destaques. Não aplicar em todos os cards."
  },
  "components": {
    "card": {
      "background": "#0D1424",
      "border": "1px solid rgba(148,163,184,.12)",
      "border_radius": "12px",
      "hover": {
        "border_color": "rgba(34,211,238,.30)",
        "transform": "translateY(-1px)"
      },
      "rule": "Evitar sombras grandes."
    },
    "button_primary": {
      "background": "linear-gradient(135deg, #1687FF, #2563EB)",
      "color": "#FFFFFF",
      "hover": "brightness(1.08)",
      "rule": "Sem glow excessivo."
    },
    "button_secondary": {
      "background": "#111A2C",
      "border": "1px solid rgba(148,163,184,.16)",
      "color": "#CBD5E1"
    },
    "button_premium": {
      "background": "linear-gradient(135deg, #2563EB, #7C3AED)",
      "allowed_for": [
        "Upgrade",
        "Ativar PRO",
        "Testar recurso premium"
      ]
    },
    "input": {
      "height": "40px",
      "background": "#0B1120",
      "border": "1px solid rgba(148,163,184,.16)",
      "border_radius": "8px",
      "focus": {
        "border_color": "#1687FF",
        "box_shadow": "0 0 0 3px rgba(22,135,255,.12)"
