{
  "meta": {
    "name": "CryptoScanner Design System",
    "version": "1.0.0",
    "language": "pt-BR",
    "purpose": "Guia oficial de design, UI/UX e identidade visual para toda a aplicação CryptoScanner.",
    "product_type": "SaaS de análise técnica, scanner de padrões, alertas, backtests, inteligência de mercado e recursos de IA para criptomoedas.",
    "core_positioning": [
      "tecnologia",
      "precisão",
      "inteligência",
      "velocidade",
      "confiança",
      "análise técnica",
      "inteligência de mercado",
      "produto premium"
    ]
  },
  "brand_strategy": {
    "desired_perception": "Plataforma profissional de inteligência de mercado e análise técnica; não parecer cassino, NFT, hype ou aplicativo cripto genérico.",
    "visual_benchmark_direction": [
      "TradingView",
      "Bloomberg Terminal",
      "Linear",
      "Stripe",
      "CoinMarketCap",
      "SaaS financeiro premium"
    ],
    "brand_principle": "O produto deve parecer caro antes mesmo de o usuário ler o preço.",
    "decision_rule": "Antes de adicionar qualquer elemento visual, perguntar: isso ajuda o usuário a compreender o mercado ou apenas deixa a tela mais chamativa? Se for apenas decorativo, não adicionar."
  },
  "logo": {
    "official_symbol": {
      "description": "Símbolo C geométrico do CryptoScanner com três candlesticks internos.",
      "meaning": {
        "C": "CryptoScanner",
        "candlesticks": "análise técnica",
        "ascending_movement": "detecção de tendências e oportunidades",
        "open_structure": "scanner procurando sinais no mercado"
      },
      "recommended_uses": [
        "favicon",
        "PWA",
        "avatar",
        "sidebar recolhida",
        "loading",
        "notificações",
        "ícone de aplicativo",
        "cards pequenos",
        "áreas onde o nome CryptoScanner já esteja visível"
      ]
    },
    "primary_lockup": "[símbolo C] CryptoScanner",
    "tier_rule": "PRO e ELITE não possuem logos diferentes. Existe uma única marca CryptoScanner; PRO e ELITE entram como badges/submarcas.",
    "protection_area": "0.25x da largura do símbolo ao redor.",
    "forbidden": [
      "esticar",
      "inclinar",
      "adicionar sombras pesadas",
      "adicionar bordas arbitrárias",
      "alterar a proporção",
      "mudar as cores sem necessidade",
      "adicionar candlesticks extras",
      "colocar Bitcoin ou moedas dentro do símbolo"
    ],
    "required_variants": [
      "gradient",
      "branca",
      "preta",
      "monocromática azul",
      "monocromática clara"
    ],
    "style_rule": "A logo precisa funcionar sem glow. O glow é efeito da interface, não parte essencial da identidade."
  },
  "color_system": {
    "background": {
      "primary": "#070B14",
      "secondary": "#0B1120",
      "tertiary": "#101827",
      "rule": "Evitar preto absoluto #000000 em grandes áreas."
    },
    "surfaces": {
